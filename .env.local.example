# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://drink-cafete.ch

# --- Stripe -------------------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks, or `stripe listen` for local dev
STRIPE_WEBHOOK_SECRET=whsec_...

# One Price ID per pack size (6, 12 and 24 — there is no single-bottle SKU).
# A pack only appears in the shop once its Price ID is set here, so you can
# launch pack sizes one at a time.
STRIPE_PRICE_PACK_6=price_...
STRIPE_PRICE_PACK_12=price_...
STRIPE_PRICE_PACK_24=price_...

# Optional. Comma-separated ISO country codes; defaults to CH only.
# STRIPE_SHIPPING_COUNTRIES=CH,LI

# Optional. A Stripe Shipping Rate ID (Dashboard → Shipping rates). Without it,
# Checkout collects an address but charges no shipping.
# STRIPE_SHIPPING_RATE=shr_...

# Optional. Leave unset until CAFÉTÉ is VAT-registered — below the CHF 100k
# threshold you may not charge MwSt at all. Requires Stripe Tax to be enabled.
# STRIPE_TAX_ENABLED=true

# --- Transactional email ------------------------------------------------
# ON RAILWAY, USE RESEND. Railway blocks outbound SMTP: ports 465, 587 and 2525
# to mail.infomaniak.com all time out on TCP connect from inside the container,
# while all three answer in ~1.1s from a normal network. No port or password
# gets around it. See the README section "Railway blocks outbound SMTP".

# Resend sends over HTTPS, so it is unaffected.
#
# RESEND_FROM does NOT have to be a real mailbox. Resend authenticates with the
# API key against a verified DOMAIN and signs with DKIM, so
# noreply@send.drink-cafete.ch needs nothing created at Infomaniak — which
# matters, because the account there only has the one info@ mailbox. This is the
# opposite of SMTP, where you log in *as* a mailbox and so one must exist.
#
# Verify the SUBDOMAIN send.drink-cafete.ch in Resend, never the root: a domain
# gets one SPF record, the root's already ends in -all, and it carries the
# founders' live mail.
#
# Mail sent TO noreply@send.drink-cafete.ch bounces, since there is no mailbox
# behind it. That is intended for a no-reply sender — the code sets Reply-To to
# ORDER_NOTIFICATION_EMAIL on the customer confirmation, so replies still land
# somewhere real.
RESEND_API_KEY=re_...
RESEND_FROM="CAFÉTÉ <noreply@send.drink-cafete.ch>"

# Where registrations and order notifications land, and what Reply-To points at.
# Defaults to info@drink-cafete.ch.
ORDER_NOTIFICATION_EMAIL=info@drink-cafete.ch

# --- SMTP: kept for a host with open SMTP egress, unset on Railway -------
# Infomaniak SMTP works fine from a normal network and needs no DNS work, since
# drink-cafete.ch already authorises Infomaniak in its SPF record. Leave these
# UNSET on Railway: when both transports are configured, SMTP is tried first and
# every message pays its connection timeout before falling through to Resend.
#
# SMTP_USER must be the FULL email address of a real mailbox, and SMTP_PASSWORD
# an application-specific password ("Gerätepasswort") created per mailbox in the
# Infomaniak Manager — the normal account login password is refused for SMTP.
# A dedicated mailbox would be better than info@, because a mailbox password can
# read mail as well as send it; the Infomaniak plan in use only allows the one.
#
# MAIL_FROM must be an address the SMTP_USER mailbox may send as, or Infomaniak
# refuses it. Left unset, the code sends from SMTP_USER, which is always allowed.
# It applies to SMTP only — RESEND_FROM covers the Resend path, and the two are
# not interchangeable.
#
# The quotes below are .env syntax and are stripped when this file is loaded.
# Setting variables in the Railway UI instead? Paste the value WITHOUT quotes.
#
# Either port works: 587 with STARTTLS (what Infomaniak documents) or 465 with
# implicit TLS.
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=587
# SMTP_USER=info@drink-cafete.ch
# SMTP_PASSWORD=
# MAIL_FROM="CAFÉTÉ <info@drink-cafete.ch>"
