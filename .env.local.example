# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://drink-cafete.ch

# --- Stripe -------------------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks, or `stripe listen` for local dev
STRIPE_WEBHOOK_SECRET=whsec_...

# One Price ID per pack size (6, 12 and 24 — there is no single-bottle SKU).
# A pack only appears in the shop once its Price ID is set here, so you can
# launch pack sizes one at a time.
STRIPE_PRICE_PACK_6=price_...
STRIPE_PRICE_PACK_12=price_...
STRIPE_PRICE_PACK_24=price_...

# Optional. Comma-separated ISO country codes; defaults to CH only.
# STRIPE_SHIPPING_COUNTRIES=CH,LI

# Optional. A Stripe Shipping Rate ID (Dashboard → Shipping rates). Without it,
# Checkout collects an address but charges no shipping.
# STRIPE_SHIPPING_RATE=shr_...

# Optional. Leave unset until CAFÉTÉ is VAT-registered — below the CHF 100k
# threshold you may not charge MwSt at all. Requires Stripe Tax to be enabled.
# STRIPE_TAX_ENABLED=true

# --- Transactional email ------------------------------------------------
# Preferred: SMTP through Infomaniak, where the mailboxes already live. No DNS
# work needed — drink-cafete.ch already authorises Infomaniak in its SPF record.
#
# Use a DEDICATED mailbox here, not info@. A mailbox password can read mail as
# well as send it, so give this credential as little reach as possible.
#
# MAIL_FROM must be an address the SMTP_USER mailbox is allowed to send as —
# Infomaniak rejects anything else. If you leave it unset the code now sends from
# SMTP_USER, which is always allowed; that is the safer default.
#
# The quotes below are .env syntax and are stripped when this file is loaded.
# Setting variables in the Railway UI instead? Paste the value WITHOUT quotes.
#
# Either port works: 587 with STARTTLS (what Infomaniak's own documentation
# lists) or 465 with implicit TLS. The port was never the problem — sends from
# Railway were failing with ENETUNREACH on Infomaniak's IPv6 address, because
# nodemailer picks at random between the A and AAAA records and the container has
# no IPv6 route. `src/lib/email.ts` now pins the connection to IPv4.
#
# SMTP_USER must be the FULL email address, and SMTP_PASSWORD must be an
# application-specific password ("Gerätepasswort"), created per mailbox in the
# Infomaniak Manager. Infomaniak refuses the normal account login password for
# SMTP.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=noreply@drink-cafete.ch
SMTP_PASSWORD=
MAIL_FROM="CAFÉTÉ <noreply@drink-cafete.ch>"

# Where registrations and order notifications land. Defaults to info@drink-cafete.ch.
ORDER_NOTIFICATION_EMAIL=info@drink-cafete.ch

# Fallback transport, used only if no SMTP_* vars are set.
# RESEND_API_KEY=re_...
# RESEND_FROM="CAFÉTÉ <noreply@send.drink-cafete.ch>"
