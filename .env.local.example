# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://drink-cafete.ch

# --- Stripe (Phase 2) ---------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks (or `stripe listen` for local dev)
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs per pack size — create the Product + Prices in Stripe first.
STRIPE_PRICE_PACK_1=price_...
STRIPE_PRICE_PACK_6=price_...
STRIPE_PRICE_PACK_12=price_...
STRIPE_PRICE_PACK_24=price_...

# --- Transactional email (Phase 2) --------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM="CAFÉTÉ <info@drink-cafete.ch>"
ORDER_NOTIFICATION_EMAIL=info@drink-cafete.ch
